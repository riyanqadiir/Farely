{
  "expo": {
    "name": "Farely",
    "slug": "farely",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "farely",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Farely uses your photos to set your profile picture."
        }
      ],
      "expo-maps",
      "./plugins/withGradleJvmArgs",
      "./plugins/withAndroidProviderQueries",
      "./plugins/withFareAccessibilityService"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farely.app",
      "buildNumber": "1",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tel",
          "telprompt",
          "geo",
          "yandexyango",
          "yango",
          "bykea",
          "bykeapk",
          "tel",
          "telprompt",
          "geo",
          "yandexyango",
          "yango",
          "bykea",
          "bykeapk"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "usesCleartextTraffic": true,
      "edgeToEdgeEnabled": true,
      "package": "com.farely.app",
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBMeAW6Aj0j8-7N6l47W43yecXFJlJ--TU"
        }
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.ico"
    },
    "extra": {
      "googleMapsApiKey": "AIzaSyBMeAW6Aj0j8-7N6l47W43yecXFJlJ--TU",
      "eas": {
        "projectId": "c7383335-1cad-4137-a29b-0bb8ac732fb7"
      }
    },
    "owner": "rayyanbhattis-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c7383335-1cad-4137-a29b-0bb8ac732fb7"
    }
  }
}
