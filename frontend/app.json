{
  "expo": {
    "name": "Farely",
    "slug": "farely",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "farely",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Farely uses your photos to set your profile picture."
        }
      ],
      "expo-maps",
      "./plugins/withFareAccessibilityService"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farely.app",
      "buildNumber": "1",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tel",
          "telprompt",
          "geo",
          "yandexyango",
          "yango",
          "bykea",
          "bykeapk"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "usesCleartextTraffic": true,
      "edgeToEdgeEnabled": true,
      "package": "com.farely.app",
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBMeAW6Aj0j8-7N6l47W43yecXFJlJ--TU"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.ico"
    },
    "extra": {
      "googleMapsApiKey": "AIzaSyBMeAW6Aj0j8-7N6l47W43yecXFJlJ--TU"
    }
  }
}
