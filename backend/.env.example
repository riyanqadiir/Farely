# Server
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/Farely

# JWT (required)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (SSO) – Client ID only (no secret). Backend accepts tokens from any.
# Android: create Android OAuth client in Google Cloud → copy Client ID here
GOOGLE_CLIENT_ID=
# iOS: create iOS OAuth client in Google Cloud → copy Client ID here
GOOGLE_IOS_CLIENT_ID=
# Optional: Web OAuth client ID (if using Web client for Android id_token in native sign-in)
# GOOGLE_WEB_CLIENT_ID=

# Twilio (SMS OTP – free trial at twilio.com)
# Verify API: no phone number needed – Twilio sends and checks the code
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Leave TWILIO_PHONE_NUMBER unset – no need to buy a number

# Brevo (email OTP & forgot password – free tier at brevo.com)
# Both required: API key + a sender email that is verified in Brevo (Sender & Domains)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=


# AWS S3 (profile photos) – see backend/docs/AWS_S3_SETUP.md for step-by-step setup
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
# Optional: custom URL for profile photos (e.g. CDN)
# AWS_S3_PUBLIC_URL=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8081
